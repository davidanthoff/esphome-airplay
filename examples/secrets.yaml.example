# Copy to secrets.yaml (git-ignored) next to the example config.
wifi_ssid: "your-ssid"
wifi_password: "your-password"

# API encryption keys, one per device: 32 random bytes, base64. Generate with
# "openssl rand -base64 32" (ESPHome Builder also makes one for new devices).
living_room_speakers__encryption_key: "cmVwbGFjZS1tZS1yZXBsYWNlLW1lLXJlcGxhY2UtbWU="
dining_room_speakers__encryption_key: "cmVwbGFjZS1tZS1yZXBsYWNlLW1lLXJlcGxhY2UtbWU="
