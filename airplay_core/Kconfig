# Subset of upstream main/Kconfig.projbuild (airplay-esp32 @ 764ffb6) that the
# compiled sources read. ESPHome sets these from YAML via
# esp32.add_idf_sdkconfig_option() in components/airplay/media_source.py.
# Keep names identical to upstream so the vendored code picks them up.
# AirPlay 1 vs 2 used to be CONFIG_AIRPLAY_FORCE_V1; upstream made it a
# runtime setting (settings_airplay_v1()), see airplay_core.c.

menu "AirPlay core (esphome-airplay)"

    config ENABLE_AIRPLAY_ARTWORK
        bool "Receive cover art"
        default n
        help
            Advertise artwork support in mDNS and accept cover art. Off by
            default: large images on the RTSP connection can cause drop-outs.

endmenu
